# Summarly Chat Bot — environment variables (safe placeholders only).
# Copy to .env AT THE REPOSITORY ROOT (never commit .env). Every backend
# entry point (server, migrations, reset-password) loads it automatically
# from there; variables already set in the shell take precedence.

# Backend HTTP port.
PORT=3000

# Bind address. Keep 127.0.0.1 for a local install; use 0.0.0.0 inside containers.
HOST=127.0.0.1

# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false

# PostgreSQL connection string (see docker-compose.dev.yml for local dev).
DATABASE_URL=postgres://summarly:summarly_dev_password@127.0.0.1:5432/summarly

# Master key for encrypting stored AI provider credentials (AES-256-GCM).
# Must be base64 for exactly 32 random bytes. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep it outside the database and never commit the real value. Losing it
# makes saved provider keys unrecoverable (they must be re-entered).
ENCRYPTION_KEY=replace-me-with-base64-encoded-32-random-bytes

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For
# header is trusted for client-IP derivation (rate limiting). Default:
# loopback only (covers a local dashboard proxy). Never add an untrusted
# address — it would let clients pick their own lockout bucket.
TRUSTED_PROXIES=127.0.0.1,::1

# Redis connection string for BullMQ queue state (summary jobs; see
# docker-compose.dev.yml). Queue state only — PostgreSQL remains the
# source of truth for messages, runs, and summaries. If your Redis
# requires a password, put it in the URL and never commit the real value.
REDIS_URL=redis://127.0.0.1:6379

# summary-worker: how many summary jobs run in parallel (integer 1-16).
# Keep it modest: every job may call the AI provider.
SUMMARY_CONCURRENCY=2

# Producer-side knob (the BACKEND enqueuer reads it; the retry policy is
# stored on each job at enqueue time): base delay in milliseconds for the
# exponential retry backoff of summary jobs (each failed attempt waits
# longer than the previous one). Lower it only for tests.
SUMMARY_RETRY_BASE_MS=30000

# BullMQ key-prefix namespace for the summary queue (all queue keys are
# namespaced with it). Keep the default for deployments; test suites use
# "summarly-test" and the end-to-end check "summarly-e2e" so they can
# share a Redis with a running instance without stealing its jobs.
SUMMARY_QUEUE_PREFIX=summarly

# How often the backend re-checks summary runs that lost their queue job
# (milliseconds, integer >= 1000; values below 1000 are raised to 1000).
RECONCILE_INTERVAL_MS=60000

# Backend worker supervision (docs/decisions/0008 round 3): when true the
# backend SPAWNS and supervises the summary-worker and bot-worker child
# processes itself, so `npm run dev -w @summarly/backend` + the dashboard
# is all that is needed in dev. Each child gets SUMMARLY_PARENT_PID (the
# summary-worker polls it and shuts down gracefully if the backend
# vanishes; the bot-worker adopts the same watchdog in fix round B) and
# is stopped with the backend (Ctrl+C; force-killing the backend can
# orphan children on Windows). Set false when the workers run
# separately: the e2e script does for its own worker child, and the
# FUTURE deployment Compose must do the same and run the workers as its
# own services (no application Compose exists yet). Restart policy:
# exponential backoff (1s..60s) and 5 restarts per 10 minutes per
# worker; past that the backend logs worker_supervision_paused and keeps
# serving. A stale build logs worker_entry_stale but still runs.
SUPERVISE_WORKERS=true

# Daily summary scheduler (ADR 0006): creates one "scheduled" run per
# monitored group covering the PREVIOUS calendar day in the group's time
# zone, once the group's cutoff is reached (its summary_time, or this
# install default). SCHEDULER_ENABLED accepts true/false; SCHEDULER_
# INTERVAL_MS is the pass cadence (integer >= 1000, floor 1000);
# DEFAULT_SUMMARY_TIME is HH:mm in 24-hour format.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
DEFAULT_SUMMARY_TIME=09:00

# Bounded missed-day recovery (ADR 0006): each scheduler pass also
# schedules missing windows for the previous N local days, so a day that
# lost its run is summarized on a later pass instead of silently
# expiring. Integer, clamped to 1..31. Each backfilled day costs at most
# MAX_CHUNKS_PER_RUN provider calls — the bound is deliberate.
BACKFILL_DAYS=3

# summary-worker: cost/size caps per summary run (audit M3) — a hostile
# or bloated conversation fails permanently with run error code
# "too_large" before any AI provider call instead of spending budget.
# Positive integers; defaults shown.
MAX_MESSAGES_PER_RUN=2000
MAX_CHUNKS_PER_RUN=10

# PRIVILEGED opt-in (audit E-2): set to yes ONLY if you deliberately use
# a non-Google provider base URL. The saved API key is sent to that host
# as a request header — enabling this grants it your credentials.
# Obvious internal targets (localhost, loopback, private ranges,
# *.internal) are rejected even with this flag.
# AI_ALLOW_CUSTOM_BASE_URL=

# summary-worker: bounded timeout for one AI provider request
# (milliseconds, positive integer; default 120000).
AI_REQUEST_TIMEOUT_MS=120000

# Note (ADR 0005): the AI provider itself is configured in the
# dashboard's Settings screen (provider `google-gemini` + model
# `gemini-3.8-flash`, or `mock`/unconfigured for the deterministic
# mock). ENCRYPTION_KEY above becomes REQUIRED once a real provider is
# saved — it decrypts the stored API key. See docs/decisions/0005 for
# the verified Gemini API facts and the honest data-policy summary.

# bot-worker: directory holding the WhatsApp (Baileys) session state.
# Protected storage: keep it OUTSIDE Git (wa-session/ is gitignored), out
# of logs, out of APIs, and out of unencrypted backups — it can link
# your WhatsApp account. Relative paths resolve against the REPOSITORY
# ROOT (never the package directory); default: ./wa-session there. In
# Docker this path is the summarly-wa-session named volume (ADR 0004).
WA_SESSION_DIR=./wa-session

# bot-worker: explicit DEVELOPMENT acknowledgment (uncomment and set to
# yes) that the session state may live inside the repository working
# tree and/or that directory permissions cannot be verified (always the
# case on Windows: NTFS ACLs are the operator's job). Startup REFUSES
# unsafe session storage without it. The dev default ./wa-session is
# inside the tree, so local setups want this set (dev users keep the
# line in their local .env); real deployments point WA_SESSION_DIR at a
# protected volume OUTSIDE the repository and leave this commented out
# (ADR 0004).
# WA_SESSION_ALLOW_INSECURE=yes

# bot-worker: opt-in egress (set to yes) — fetch the latest WhatsApp Web
# version manifest from the Baileys repository when connecting. Default:
# no: the version bundled with the pinned Baileys release is used (works
# air-gapped; no third-party influence on the protocol version).
# WA_CHECK_UPDATES=

# bot-worker: linking display. "tty" renders the QR / pairing code only
# on an interactive terminal (default; required for linking). "none"
# never renders it. NEVER pipe linking output into log pipelines: a
# retained QR code is a live pairing ticket (ADR 0004).
WA_LINKING_DISPLAY=tty

# bot-worker: fallback IANA time zone for newly discovered groups when
# the dashboard's global default is unavailable. New groups start
# UNMONITORED — the admin opts each group in via the dashboard. The
# dashboard Settings → Default time zone value is the primary source;
# this env value is the fallback. Per-group settings made in the
# dashboard are never overwritten.
DEFAULT_GROUP_TIMEZONE=UTC

# Optional: link the WhatsApp session with a PAIRING CODE instead of the
# terminal QR code. International format digits (a leading + is OK), for
# example +34600111222. Leave unset/empty for QR linking (the default
# MVP flow, ADR 0004).
# WA_PHONE_NUMBER=

# bot-worker: minimum log level (debug | info | warn | error; default
# info). Set to debug to see per-chat capture summaries (counts and JIDs
# only — message bodies are NEVER logged).
LOG_LEVEL=info

# ---- History import (ADR 0007) --------------------------------------
# Bounded BEST-EFFORT backfill of older messages for monitored groups
# the admin explicitly imports (POST /api/groups/:id/history-import).
# WhatsApp decides what history is available and may return less, none,
# or several batches per request — a finished import is PARTIAL BY
# DESIGN and imported_count reports only what was newly inserted.
# Past-budget messages are simply not imported (re-requesting an
# import is allowed and harmless — ingestion is idempotent).
#
# Bounds (validated at startup): BATCH_COUNT <= 50, MAX_ROUNDS <= 100,
# MAX_MESSAGES <= 20000. Staleness invariant: the time budget plus the
# internal per-round response timeout (30 s) must stay below the
# stale-claim threshold (10 min), i.e. TIME_BUDGET_MS < 570000 — so a
# slow-but-active import is never requeued as stale (ADR 0007).
# Startup fails fast when a value is out of bounds or violates it.

# bot-worker: connect-time history policy (ADR 0007).
#   off    - privacy-first default: only ON_DEMAND responses to explicit
#            imports are processed.
#   recent - let WhatsApp's initial RECENT/INITIAL_BOOTSTRAP sync complete
#            (protocol state + app-state sync) but DROP its payload. Some
#            phones only answer ON_DEMAND requests after this sync has run.
#   full   - additionally capture INITIAL_BOOTSTRAP/RECENT/FULL history for
#            MONITORED groups (opt-in backfill). Requires a WhatsApp re-link
#            to trigger; unmonitored groups are filtered before parsing.
# See docs/decisions/0007-history-import.md before enabling "full".
WA_HISTORY_SYNC=off

# How often the bot-worker polls PostgreSQL for pending import
# requests (milliseconds, integer; floor 1000).
HISTORY_IMPORT_POLL_MS=5000

# Messages requested from WhatsApp per round (it may return fewer).
# WhatsApp caps this at 50 per on-demand query.
HISTORY_IMPORT_BATCH_COUNT=50

# Maximum request rounds per import (each round pages one batch back).
HISTORY_IMPORT_MAX_ROUNDS=20

# Maximum messages collected per import (exact cap; a batch is
# truncated to the remaining room).
HISTORY_IMPORT_MAX_MESSAGES=2000

# Wall-clock budget per import in milliseconds. When it expires the
# import finishes successfully with whatever was imported so far.
HISTORY_IMPORT_TIME_BUDGET_MS=120000

# ---- Session control (ADR 0008) -------------------------------------
# How often the bot-worker checks the admin "end/unlink session" flag
# (whatsapp_connections.logout_requested_at). When set, the worker
# revokes the linked device, deletes the local session files (the
# directory stays), and marks the connection unavailable. Milliseconds,
# integer; floor 1000.
SESSION_CONTROL_POLL_MS=3000
